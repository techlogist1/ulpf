{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ULPF",
  "version": "0.1.0",
  "identifier": "dev.ulpf.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ULPF · starting engine…",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/ulpf"],
    "resources": {
      "../../parsers/*.toml": "parsers/",
      "../../mappings/*.toml": "mappings/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
